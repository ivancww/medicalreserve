{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicalreserve/ipos-approximation-dataset-v1",
  "title": "AIA 環宇盈活儲蓄保險計劃 iPOS approximation research dataset",
  "type": "object",
  "required": ["datasetVersion", "product", "cases"],
  "additionalProperties": false,
  "properties": {
    "datasetVersion": { "const": "ipos-approximation-dataset-v1" },
    "product": { "const": "AIA 環宇盈活儲蓄保險計劃" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "caseId", "sourceFilename", "product", "productVersion", "currency",
        "paymentTerm", "issueAge", "annualPremium", "initialBasicAmount",
        "withdrawalPattern", "withdrawalStartAge", "scenarioType", "role", "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "sourceFilename": { "type": "string", "minLength": 1 },
        "proposalDate": { "type": ["string", "null"] },
        "product": { "const": "AIA 環宇盈活儲蓄保險計劃" },
        "productVersion": { "type": "string", "minLength": 1 },
        "currency": { "const": "HKD" },
        "paymentTerm": { "const": 5 },
        "issueAge": { "type": "integer", "minimum": 0 },
        "annualPremium": { "type": "number", "exclusiveMinimum": 0 },
        "initialBasicAmount": { "type": "number", "exclusiveMinimum": 0 },
        "withdrawalPattern": { "enum": ["Original", "AVF", "AVPU"] },
        "withdrawalStartAge": { "type": "integer", "minimum": 0 },
        "scenarioType": { "const": "currentProjected" },
        "role": { "enum": ["calibration", "holdout", "regression"] },
        "sourceHash": { "type": ["string", "null"] },
        "sourceFileId": { "type": ["string", "null"] },
        "baseCurve": {
          "type": "array",
          "items": { "$ref": "#/$defs/basePoint" }
        },
        "withdrawalSchedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/withdrawalPoint" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/row" }
        }
      }
    },
    "basePoint": {
      "type": "object",
      "required": ["policyYear", "paidPremiumTotal", "guaranteedCashValue", "reversionaryBonusCashValue", "terminalDividendCashValue", "projectedRemainingSurrenderValue"],
      "additionalProperties": false,
      "properties": {
        "policyYear": { "type": "integer", "minimum": 0 },
        "paidPremiumTotal": { "type": "number", "minimum": 0 },
        "guaranteedCashValue": { "type": "number", "minimum": 0 },
        "reversionaryBonusCashValue": { "type": "number", "minimum": 0 },
        "terminalDividendCashValue": { "type": "number", "minimum": 0 },
        "projectedRemainingSurrenderValue": { "type": "number", "minimum": 0 }
      }
    },
    "withdrawalPoint": {
      "type": "object",
      "required": ["age", "policyYear", "withdrawal"],
      "additionalProperties": false,
      "properties": {
        "age": { "type": "integer", "minimum": 0 },
        "policyYear": { "type": "integer", "minimum": 0 },
        "withdrawal": { "type": "number", "minimum": 0 },
        "withdrawalFromReversionaryBonus": { "type": "number", "minimum": 0 },
        "withdrawalFromGuaranteedCashValue": { "type": "number", "minimum": 0 },
        "withdrawalFromTerminalDividend": { "type": "number", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "required": ["age", "policyYear", "withdrawalType", "withdrawal", "projectedRemainingSurrenderValue"],
      "additionalProperties": false,
      "properties": {
        "age": { "type": "integer", "minimum": 0 },
        "policyYear": { "type": "integer", "minimum": 0 },
        "withdrawalType": { "enum": ["medicalWithdrawal", "zeroWithdrawal", "fullSurrender"] },
        "withdrawal": { "type": "number", "minimum": 0 },
        "basicAmountAfterWithdrawal": { "type": ["number", "null"], "minimum": 0 },
        "guaranteedCashValue": { "type": ["number", "null"], "minimum": 0 },
        "reversionaryBonusCashValue": { "type": ["number", "null"], "minimum": 0 },
        "terminalDividendCashValue": { "type": ["number", "null"], "minimum": 0 },
        "withdrawalFromGuaranteedCashValue": { "type": ["number", "null"], "minimum": 0 },
        "withdrawalFromReversionaryBonus": { "type": ["number", "null"], "minimum": 0 },
        "withdrawalFromTerminalDividend": { "type": ["number", "null"], "minimum": 0 },
        "projectedRemainingSurrenderValue": { "type": "number", "minimum": 0 }
      }
    }
  }
}
